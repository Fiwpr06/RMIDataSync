<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="760.0" prefWidth="1200.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiwpr06.rmidatasync.client.controller.ClientMainController">
    <!-- Top Header Bar -->
    <HBox styleClass="connect-bar" alignment="CENTER_LEFT" spacing="14.0">
        <Label text="⚡ RMIDATA SYNC" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 15px;" />
        <Separator orientation="VERTICAL" />
        <Label fx:id="lblCurrentUser" text="👤 Người dùng: Guest" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
        <Separator orientation="VERTICAL" />
        <Label fx:id="lblCurrentServer" text="⚡ Máy chủ: Node A (127.0.0.1:1099)" styleClass="field-label" />
        <Label fx:id="lblNodeStatus" text="ĐÃ KẾT NỐI" style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-background-color: #DCFCE7; -fx-padding: 3px 8px; -fx-background-radius: 12px;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Chuyển máy chủ kiểm chứng:" styleClass="field-label" />
        <Button text="Node A (1099)" onAction="#switchToNodeA" styleClass="btn-secondary" />
        <Button text="Node B (1100)" onAction="#switchToNodeB" styleClass="btn-secondary" />
        <Separator orientation="VERTICAL" />
        <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="btn-danger" text="🚪 Đăng xuất" />
    </HBox>

    <!-- Main Workspace SplitPane -->
    <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-padding: 8px;">
        <!-- Left: Product Table & Search -->
        <VBox spacing="10.0" styleClass="card-panel">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="📦 Danh mục Kho Hàng &amp; Sản phẩm:" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E3A8A;" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" prefWidth="280.0" promptText="🔍 Tìm theo mã SP, tên, danh mục..." styleClass="text-input-field" />
                <Button onAction="#handleRefresh" styleClass="btn-secondary" text="🔄 Làm mới" />
            </HBox>
            <TableView fx:id="tblRecords" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" minWidth="90.0" prefWidth="95.0" text="Mã SP" />
                    <TableColumn fx:id="colTitle" minWidth="200.0" prefWidth="260.0" text="Tên sản phẩm / Thiết bị" />
                    <TableColumn fx:id="colCategory" minWidth="100.0" prefWidth="120.0" text="Phân loại" />
                    <TableColumn fx:id="colPrice" minWidth="110.0" prefWidth="125.0" text="Đơn giá" />
                    <TableColumn fx:id="colQuantity" minWidth="75.0" prefWidth="80.0" text="Tồn kho" />
                    <TableColumn fx:id="colStatus" minWidth="85.0" prefWidth="95.0" text="Trạng thái" />
                    <TableColumn fx:id="colVersion" minWidth="65.0" prefWidth="70.0" text="Phiên bản" />
                    <TableColumn fx:id="colOrigin" minWidth="80.0" prefWidth="90.0" text="Node gốc" />
                    <TableColumn fx:id="colLastModified" minWidth="140.0" prefWidth="160.0" text="Cập nhật gần nhất" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right: Inventory Editor & Interactive Actions -->
        <VBox spacing="12.0" styleClass="card-panel">
            <padding>
                <Insets top="14" right="16" bottom="14" left="16" />
            </padding>
            <Label text="⚙️ CAN THIỆP &amp; ĐIỀU CHỈNH DỮ LIỆU KHO" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E3A8A;" />
            <Label text="Mọi thao tác thay đổi dữ liệu sẽ được kích hoạt đồng bộ RMI tức thời sang Server còn lại." styleClass="panel-desc" wrapText="true" />

            <Separator />

            <!-- Quick Stock Adjust Bar -->
            <VBox spacing="6.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 8px;">
                <Label text="⚡ Thao tác nhanh số lượng kho (Demo đồng bộ tức thời):" styleClass="field-label" />
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button onAction="#handleStockPlus10" text="📦 Nhập kho (+10)" styleClass="btn-stock-plus" HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleStockMinus1" text="📤 Xuất kho (-1)" styleClass="btn-stock-minus" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Form Fields -->
            <VBox spacing="4.0">
                <Label text="Mã sản phẩm (ID):" styleClass="field-label" />
                <TextField fx:id="txtRecordId" promptText="Tự động tạo nếu để trống (ví dụ: SP-105)" styleClass="text-input-field" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Tên sản phẩm / Tiêu đề:" styleClass="field-label" />
                <TextField fx:id="txtRecordTitle" promptText="Nhập tên sản phẩm..." styleClass="text-input-field" />
            </VBox>

            <HBox spacing="10.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Danh mục:" styleClass="field-label" />
                    <TextField fx:id="txtRecordCategory" promptText="Máy tính / Phụ kiện..." styleClass="text-input-field" />
                </VBox>
                <VBox spacing="4.0" prefWidth="120.0">
                    <Label text="Tồn kho:" styleClass="field-label" />
                    <TextField fx:id="txtRecordQuantity" promptText="0" text="0" styleClass="text-input-field" />
                </VBox>
            </HBox>

            <HBox spacing="10.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Đơn giá (VNĐ):" styleClass="field-label" />
                    <TextField fx:id="txtRecordPrice" promptText="0" text="0" styleClass="text-input-field" />
                </VBox>
                <VBox spacing="4.0" prefWidth="120.0">
                    <Label text="Tình trạng:" styleClass="field-label" />
                    <ComboBox fx:id="cmbRecordStatus" prefWidth="120.0" />
                </VBox>
            </HBox>

            <VBox spacing="4.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Nguồn gốc bản ghi:" styleClass="field-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblRecordOrigin" text="-" style="-fx-text-fill: #0284C7; -fx-font-weight: bold;" />
                </HBox>
            </VBox>

            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                <Label text="Mô tả chi tiết cấu hình / Ghi chú:" styleClass="field-label" />
                <TextArea fx:id="txtRecordContent" promptText="Thông số kỹ thuật, bảo hành, vị trí kho..." wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>

            <!-- Buttons Action Group -->
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Button onAction="#handleNewRecord" text="➕ Mới" styleClass="btn-secondary" />
                <Button onAction="#handleClearForm" text="🧹 Xóa form" styleClass="btn-secondary" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleDeleteRecord" text="🗑 Xóa SP" styleClass="btn-danger" />
                <Button onAction="#handleSaveRecord" text="💾 Lưu sản phẩm" styleClass="btn-primary" />
            </HBox>
        </VBox>
    </SplitPane>

    <!-- Bottom Status Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
        <Label fx:id="lblBottomStatus" text="Hệ thống phân tán sẵn sàng." styleClass="field-label" />
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="760.0" prefWidth="1200.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiwpr06.rmidatasync.client.controller.ClientMainController">
    <!-- Top Header Bar -->
    <HBox styleClass="connect-bar" alignment="CENTER_LEFT" spacing="12.0">
        <Label text="RMIDATA SYNC" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 15px;" minWidth="USE_PREF_SIZE" />
        <Separator orientation="VERTICAL" />
        <Label fx:id="lblCurrentUser" text="Người dùng: Guest" style="-fx-font-weight: bold; -fx-text-fill: #334155;" minWidth="USE_PREF_SIZE" />
        <Separator orientation="VERTICAL" />
        <Label fx:id="lblCurrentServer" text="Máy chủ: Node A" styleClass="field-label" minWidth="USE_PREF_SIZE" />
        <Label fx:id="lblNodeStatus" text="● Đã kết nối" style="-fx-text-fill: #15803D; -fx-font-weight: bold; -fx-background-color: #DCFCE7; -fx-padding: 3px 10px; -fx-background-radius: 12px;" minWidth="USE_PREF_SIZE" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Chuyển máy chủ:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
        <Button text="Máy chủ A" onAction="#switchToNodeA" styleClass="btn-pill" minWidth="USE_PREF_SIZE" />
        <Button text="Máy chủ B" onAction="#switchToNodeB" styleClass="btn-pill" minWidth="USE_PREF_SIZE" />
        <Separator orientation="VERTICAL" />
        <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="btn-danger" text="Đăng xuất" minWidth="USE_PREF_SIZE" />
    </HBox>

    <!-- Main Workspace SplitPane -->
    <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-padding: 8px;">
        <!-- Left: Product Table & Search -->
        <VBox spacing="10.0" styleClass="card-panel">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Danh mục kho hàng:" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" prefWidth="280.0" promptText="Tìm theo mã sản phẩm, tên, phân loại..." styleClass="text-input-field" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Làm mới" minWidth="USE_PREF_SIZE" />
            </HBox>
            <TableView fx:id="tblRecords" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" minWidth="85.0" prefWidth="90.0" text="Mã SP" />
                    <TableColumn fx:id="colTitle" minWidth="200.0" prefWidth="250.0" text="Tên sản phẩm" />
                    <TableColumn fx:id="colCategory" minWidth="100.0" prefWidth="120.0" text="Phân loại" />
                    <TableColumn fx:id="colPrice" minWidth="110.0" prefWidth="120.0" text="Đơn giá" />
                    <TableColumn fx:id="colQuantity" minWidth="75.0" prefWidth="80.0" text="Tồn kho" />
                    <TableColumn fx:id="colStatus" minWidth="85.0" prefWidth="95.0" text="Trạng thái" />
                    <TableColumn fx:id="colVersion" minWidth="65.0" prefWidth="70.0" text="Phiên bản" />
                    <TableColumn fx:id="colOrigin" minWidth="80.0" prefWidth="85.0" text="Máy chủ tạo" />
                    <TableColumn fx:id="colLastModified" minWidth="140.0" prefWidth="160.0" text="Cập nhật gần nhất" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right: Inventory Editor & Interactive Actions -->
        <VBox spacing="12.0" styleClass="card-panel">
            <padding>
                <Insets top="14" right="16" bottom="14" left="16" />
            </padding>
            <Label text="ĐIỀU CHỈNH DỮ LIỆU KHO" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
            <Label text="Mọi thay đổi dữ liệu sẽ được tự động đồng bộ RMI tức thời sang máy chủ còn lại." styleClass="panel-desc" wrapText="true" />

            <Separator />

            <!-- Quick Stock Adjust Bar -->
            <VBox spacing="6.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 8px;">
                <Label text="Thao tác nhanh số lượng tồn kho:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button onAction="#handleStockPlus10" text="+ Nhập 10" styleClass="btn-stock-plus" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="USE_PREF_SIZE" />
                    <Button onAction="#handleStockMinus1" text="− Xuất 1" styleClass="btn-stock-minus" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="USE_PREF_SIZE" />
                </HBox>
            </VBox>

            <!-- Form Fields -->
            <VBox spacing="4.0">
                <Label text="Mã sản phẩm:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                <TextField fx:id="txtRecordId" promptText="Tự động tạo nếu để trống (ví dụ: SP-105)" styleClass="text-input-field" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Tên sản phẩm:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                <TextField fx:id="txtRecordTitle" promptText="Nhập tên sản phẩm..." styleClass="text-input-field" />
            </VBox>

            <HBox spacing="10.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Phân loại:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                    <TextField fx:id="txtRecordCategory" promptText="Máy tính / Phụ kiện..." styleClass="text-input-field" />
                </VBox>
                <VBox spacing="4.0" prefWidth="120.0" minWidth="100.0">
                    <Label text="Tồn kho:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                    <TextField fx:id="txtRecordQuantity" promptText="0" text="0" styleClass="text-input-field" />
                </VBox>
            </HBox>

            <HBox spacing="10.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Đơn giá:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                    <TextField fx:id="txtRecordPrice" promptText="0" text="0" styleClass="text-input-field" />
                </VBox>
                <VBox spacing="4.0" prefWidth="130.0" minWidth="110.0">
                    <Label text="Trạng thái:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                    <ComboBox fx:id="cmbRecordStatus" maxWidth="Infinity" />
                </VBox>
            </HBox>

            <VBox spacing="4.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Máy chủ khởi tạo:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblRecordOrigin" text="-" styleClass="hud-value-cyan" minWidth="USE_PREF_SIZE" />
                </HBox>
            </VBox>

            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                <Label text="Thông tin ghi chú:" styleClass="field-label" minWidth="USE_PREF_SIZE" />
                <TextArea fx:id="txtRecordContent" promptText="Mô tả kỹ thuật hoặc ghi chú kho..." wrapText="true" VBox.vgrow="ALWAYS" styleClass="text-input-field" prefHeight="70.0" />
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="8.0" alignment="CENTER_RIGHT">
                <Button onAction="#handleNewRecord" text="Thêm mới" styleClass="btn-secondary" minWidth="USE_PREF_SIZE" />
                <Button onAction="#handleSaveRecord" text="Lưu thay đổi" styleClass="btn-primary" minWidth="USE_PREF_SIZE" />
                <Button onAction="#handleDeleteRecord" text="Xóa" styleClass="btn-danger" minWidth="USE_PREF_SIZE" />
            </HBox>
        </VBox>
    </SplitPane>

    <!-- Bottom Status Bar -->
    <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="6" right="16" bottom="6" left="16" />
        </padding>
        <Label fx:id="lblBottomStatus" text="Hệ thống sẵn sàng" styleClass="footer-text" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>

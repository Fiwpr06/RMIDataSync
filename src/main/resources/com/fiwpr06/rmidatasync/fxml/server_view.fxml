<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="760.0" prefWidth="1200.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiwpr06.rmidatasync.server.controller.ServerDashboardController">
    <!-- Header HUD Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="hud-bar">
        <Label fx:id="lblNodeTitle" styleClass="hud-title" text="RMI NODE DASHBOARD - NODE_A" minWidth="USE_PREF_SIZE" />
        <Separator orientation="VERTICAL" />
        <Label text="Máy chủ này:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <Label fx:id="lblLocalInfo" text="127.0.0.1:1099" styleClass="hud-value-cyan" minWidth="USE_PREF_SIZE" />
        <Button onAction="#handleCopyLocalAddress" text="Sao chép địa chỉ" styleClass="btn-utility" minWidth="USE_PREF_SIZE" />
        <Separator orientation="VERTICAL" />
        <Label text="Máy đối tác:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <Label fx:id="lblPeerInfo" text="127.0.0.1:1100" styleClass="hud-value-green" minWidth="USE_PREF_SIZE" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblPeerBadge" styleClass="badge-offline" text="● Đang chờ máy đối tác" minWidth="USE_PREF_SIZE" />
    </HBox>

    <!-- Interactive Peer Configuration & Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="connection-info-bar">
        <Label text="Kết nối đối tác:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 13px;" minWidth="USE_PREF_SIZE" />
        <Label text="IP:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <TextField fx:id="txtPeerHost" prefWidth="125.0" minWidth="95.0" promptText="127.0.0.1" text="127.0.0.1" />
        <Label text="Cổng:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <TextField fx:id="txtPeerPort" prefWidth="65.0" minWidth="55.0" promptText="1100" text="1100" />
        <Button onAction="#handleSetPeerPresetA" text="Cổng 1099" styleClass="btn-pill" minWidth="USE_PREF_SIZE" />
        <Button onAction="#handleSetPeerPresetB" text="Cổng 1100" styleClass="btn-pill" minWidth="USE_PREF_SIZE" />
        <Button fx:id="btnUpdatePeer" onAction="#handleUpdatePeer" text="Áp dụng" styleClass="btn-primary" minWidth="USE_PREF_SIZE" />
        <Button fx:id="btnForceSync" disable="true" onAction="#handleForceReconcile" text="Đồng bộ bù" styleClass="btn-action" minWidth="USE_PREF_SIZE" />
        <Label fx:id="lblCopyFeedback" text="" styleClass="feedback-toast" minWidth="USE_PREF_SIZE" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleRefreshAll" text="Làm mới" styleClass="btn-secondary" minWidth="USE_PREF_SIZE" />
        <Button onAction="#clearConsole" text="Xóa nhật ký" styleClass="btn-secondary" minWidth="USE_PREF_SIZE" />
    </HBox>

    <!-- Data Overview Stats Cards -->
    <HBox spacing="16.0" style="-fx-background-color: #F8FAFC; -fx-padding: 14px 20px;">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-card-title" text="TỔNG SẢN PHẨM TRONG KHO" />
            <Label fx:id="lblTotalRecords" styleClass="stat-card-number" text="0" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-card-title" text="ĐÃ ĐỒNG BỘ" />
            <Label fx:id="lblSyncedRecords" styleClass="stat-card-number-green" text="0" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-card-title" text="ĐANG CHỜ BÙ DỮ LIỆU" />
            <Label fx:id="lblPendingRecords" styleClass="stat-card-number-orange" text="0" />
        </VBox>
    </HBox>

    <!-- Main Content Tabs -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- Tab 1: Records -->
        <Tab text="Danh mục kho hàng">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Dữ liệu kho hàng thực tế trên cơ sở dữ liệu MySQL của Node:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Tự động đồng bộ hóa đa máy chủ qua RMI" style="-fx-text-fill: #64748B; -fx-font-style: italic;" minWidth="USE_PREF_SIZE" />
                </HBox>
                <TableView fx:id="tblRecords" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRecId" minWidth="90.0" prefWidth="95.0" text="Mã SP" />
                        <TableColumn fx:id="colRecTitle" minWidth="200.0" prefWidth="260.0" text="Tên sản phẩm" />
                        <TableColumn fx:id="colRecCategory" minWidth="100.0" prefWidth="120.0" text="Phân loại" />
                        <TableColumn fx:id="colRecPrice" minWidth="110.0" prefWidth="125.0" text="Đơn giá" />
                        <TableColumn fx:id="colRecQuantity" minWidth="75.0" prefWidth="80.0" text="Tồn kho" />
                        <TableColumn fx:id="colRecStatus" minWidth="85.0" prefWidth="95.0" text="Trạng thái" />
                        <TableColumn fx:id="colRecVersion" minWidth="65.0" prefWidth="70.0" text="Phiên bản" />
                        <TableColumn fx:id="colRecOrigin" minWidth="80.0" prefWidth="90.0" text="Máy chủ tạo" />
                        <TableColumn fx:id="colRecSynced" minWidth="100.0" prefWidth="110.0" text="Đồng bộ" />
                        <TableColumn fx:id="colRecTime" minWidth="140.0" prefWidth="160.0" text="Thời gian sửa đổi" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 2: Events -->
        <Tab text="Nhật ký đồng bộ">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Nhật ký các sự kiện nhân bản dữ liệu qua mạng:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                </HBox>
                <TableView fx:id="tblEvents" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEvId" minWidth="50.0" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colEvType" minWidth="100.0" prefWidth="120.0" text="Loại sự kiện" />
                        <TableColumn fx:id="colEvRecId" minWidth="90.0" prefWidth="100.0" text="Mã SP" />
                        <TableColumn fx:id="colEvTitle" minWidth="180.0" prefWidth="250.0" text="Tiêu đề bản ghi" />
                        <TableColumn fx:id="colEvSource" minWidth="100.0" prefWidth="120.0" text="Nguồn phát" />
                        <TableColumn fx:id="colEvTarget" minWidth="120.0" prefWidth="150.0" text="Đích nhận" />
                        <TableColumn fx:id="colEvStatus" minWidth="90.0" prefWidth="110.0" text="Trạng thái" />
                        <TableColumn fx:id="colEvTime" minWidth="150.0" prefWidth="180.0" text="Thời gian" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 3: Console -->
        <Tab text="Nhật ký máy chủ">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <TextArea fx:id="txtConsole" editable="false" styleClass="console-area" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>
    </TabPane>
</VBox>

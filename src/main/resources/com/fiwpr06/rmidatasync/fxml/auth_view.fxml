<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fiwpr06.rmidatasync.client.controller.AuthViewController"
            prefWidth="740.0" prefHeight="580.0"
            stylesheets="@../css/client.css">

    <!-- Top Branding Bar -->
    <top>
        <HBox styleClass="header-bar" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="⚡ RMIDATA SYNC" styleClass="header-title"/>
            <Label text="DISTRIBUTED INVENTORY MANAGEMENT" styleClass="header-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="KIẾN TRÚC:" styleClass="status-pill-label"/>
            <Label text="JAVA RMI MULTI-MASTER" styleClass="status-pill-value"/>
        </HBox>
    </top>

    <!-- Center Card: Server Selection & Auth Tabs -->
    <center>
        <VBox alignment="CENTER" spacing="16">
            <VBox styleClass="card-panel" prefWidth="540.0" maxWidth="540.0" spacing="14">
                <padding>
                    <Insets top="20" right="28" bottom="20" left="28"/>
                </padding>

                <!-- Server Selection Header -->
                <Label text="CHỌN MÁY CHỦ KẾT NỐI (SERVER NODE)" styleClass="panel-title"/>
                <Label text="Chọn hoặc nhập địa chỉ IP/Port của máy chủ (Node A hoặc Node B) để đăng nhập." styleClass="panel-desc"/>

                <!-- Host & Port Row -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Địa chỉ IP Máy chủ (Host):" styleClass="field-label"/>
                        <TextField fx:id="txtHost" promptText="127.0.0.1 (hoặc IP máy thực/máy ảo)" text="127.0.0.1" styleClass="text-input-field"/>
                    </VBox>
                    <VBox spacing="4" prefWidth="100.0">
                        <Label text="Cổng (Port):" styleClass="field-label"/>
                        <TextField fx:id="txtPort" promptText="1099" text="1099" styleClass="text-input-field"/>
                    </VBox>
                </HBox>

                <!-- Quick Server Toggle Buttons -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Chọn nhanh:" styleClass="field-label"/>
                    <Button text="⚡ Node A (Port 1099)" onAction="#selectNodeA" styleClass="btn-secondary"/>
                    <Button text="⚡ Node B (Port 1100)" onAction="#selectNodeB" styleClass="btn-secondary"/>
                </HBox>

                <Separator/>

                <!-- Auth Tabs: Sign In / Sign Up -->
                <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="230.0">
                    <!-- Tab 1: Sign In -->
                    <Tab text="ĐĂNG NHẬP">
                        <VBox spacing="12">
                            <padding>
                                <Insets top="12" right="6" bottom="6" left="6"/>
                            </padding>
                            <VBox spacing="4">
                                <Label text="Tên đăng nhập:" styleClass="field-label"/>
                                <TextField fx:id="txtLoginUser" promptText="admin / user1 / user2" text="admin" styleClass="text-input-field"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Mật khẩu:" styleClass="field-label"/>
                                <PasswordField fx:id="txtLoginPass" promptText="Mật khẩu" text="123" styleClass="text-input-field"/>
                            </VBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <padding><Insets top="6"/></padding>
                                <Button fx:id="btnLogin" text="ĐĂNG NHẬP HỆ THỐNG" onAction="#handleLogin"
                                        styleClass="btn-primary" defaultButton="true" prefWidth="200.0"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Sign Up -->
                    <Tab text="ĐĂNG KÝ TÀI KHOẢN MỚI">
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" right="6" bottom="6" left="6"/>
                            </padding>
                            <HBox spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Tên đăng nhập mới:" styleClass="field-label"/>
                                    <TextField fx:id="txtRegUser" promptText="Ví dụ: nhanvien1" styleClass="text-input-field"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Mật khẩu:" styleClass="field-label"/>
                                    <PasswordField fx:id="txtRegPass" promptText="Mật khẩu" styleClass="text-input-field"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="4">
                                <Label text="Họ và tên người dùng:" styleClass="field-label"/>
                                <TextField fx:id="txtRegFullName" promptText="Ví dụ: Nguyễn Văn C" styleClass="text-input-field"/>
                            </VBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <padding><Insets top="6"/></padding>
                                <Button fx:id="btnRegister" text="TẠO TÀI KHOẢN" onAction="#handleRegister"
                                        styleClass="btn-action" prefWidth="180.0"/>
                            </HBox>
                        </VBox>
                    </Tab>
                </TabPane>

                <!-- Status Feedback Label -->
                <Label fx:id="lblStatus" text="[ SẴN SÀNG ] Vui lòng chọn máy chủ và đăng nhập." styleClass="status-label-normal" wrapText="true"/>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Footer -->
    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="RMIDataSync © 2026 - Kiểm soát phiên phân tán (Single Active Session across Servers)" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>

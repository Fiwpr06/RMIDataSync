<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fiwpr06.rmidatasync.client.controller.AuthViewController"
            prefWidth="780.0" prefHeight="620.0"
            stylesheets="@../css/client.css">

    <!-- Top Branding Bar -->
    <top>
        <HBox styleClass="header-bar" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="RMIDATA SYNC" styleClass="header-title"/>
            <Label text="HỆ THỐNG QUẢN LÝ KHO PHÂN TÁN" styleClass="header-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="KIẾN TRÚC:" styleClass="status-pill-label"/>
            <Label text="JAVA RMI MULTI-MASTER" styleClass="status-pill-value"/>
        </HBox>
    </top>

    <!-- Center Card: Server Selection & Auth Tabs -->
    <center>
        <VBox alignment="CENTER" spacing="16">
            <VBox styleClass="card-panel" prefWidth="580.0" maxWidth="580.0" spacing="14">
                <padding>
                    <Insets top="20" right="28" bottom="20" left="28"/>
                </padding>

                <!-- Server Selection Header -->
                <Label text="CHỌN MÁY CHỦ KẾT NỐI" styleClass="panel-title"/>
                <Label text="Chọn hoặc nhập địa chỉ máy chủ Node A hoặc Node B để đăng nhập." styleClass="panel-desc"/>

                <!-- Host & Port Row -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Địa chỉ máy chủ:" styleClass="field-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="txtHost" promptText="127.0.0.1 hoặc IP mạng LAN" text="127.0.0.1" styleClass="text-input-field" HBox.hgrow="ALWAYS"/>
                            <Button text="Dán" onAction="#handlePasteHost" styleClass="btn-pill" />
                        </HBox>
                    </VBox>
                    <VBox spacing="4" prefWidth="100.0">
                        <Label text="Cổng:" styleClass="field-label"/>
                        <TextField fx:id="txtPort" promptText="1099" text="1099" styleClass="text-input-field"/>
                    </VBox>
                </HBox>

                <!-- Quick Server Toggle Buttons -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Chọn nhanh máy chủ:" styleClass="field-label"/>
                    <Button text="127.0.0.1" onAction="#selectLocalhost" styleClass="btn-pill" />
                    <Button text="Máy chủ A - Cổng 1099" onAction="#selectNodeA" styleClass="btn-pill" />
                    <Button text="Máy chủ B - Cổng 1100" onAction="#selectNodeB" styleClass="btn-pill" />
                </HBox>

                <Separator/>

                <!-- Auth Tabs: Sign In / Sign Up -->
                <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="240.0">
                    <!-- Tab 1: Sign In -->
                    <Tab text="ĐĂNG NHẬP">
                        <VBox spacing="10">
                            <padding>
                                <Insets top="10" right="6" bottom="6" left="6"/>
                            </padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Tài khoản mẫu:" styleClass="field-label"/>
                                <Button text="admin" onAction="#handleFillAdmin" styleClass="btn-pill" />
                                <Button text="user1" onAction="#handleFillUser1" styleClass="btn-pill" />
                            </HBox>
                            <VBox spacing="4">
                                <Label text="Tên đăng nhập:" styleClass="field-label"/>
                                <TextField fx:id="txtLoginUser" promptText="admin hoặc user1" text="admin" styleClass="text-input-field"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Mật khẩu:" styleClass="field-label"/>
                                <PasswordField fx:id="txtLoginPass" promptText="Mật khẩu" text="admin123" styleClass="text-input-field"/>
                            </VBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <padding><Insets top="4"/></padding>
                                <Button fx:id="btnLogin" text="ĐĂNG NHẬP" onAction="#handleLogin"
                                        styleClass="btn-primary" defaultButton="true" prefWidth="180.0" />
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Sign Up -->
                    <Tab text="ĐĂNG KÝ TÀI KHOẢN MỚI">
                        <VBox spacing="8">
                            <padding>
                                <Insets top="10" right="6" bottom="6" left="6"/>
                            </padding>
                            <HBox spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Tên đăng nhập mới:" styleClass="field-label"/>
                                    <TextField fx:id="txtRegUser" promptText="Ví dụ: nhanvien1" styleClass="text-input-field"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Mật khẩu:" styleClass="field-label"/>
                                    <PasswordField fx:id="txtRegPass" promptText="Mật khẩu" styleClass="text-input-field"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="4">
                                <Label text="Họ và tên người dùng:" styleClass="field-label"/>
                                <TextField fx:id="txtRegFullName" promptText="Họ và tên nhân viên..." styleClass="text-input-field"/>
                            </VBox>
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <padding><Insets top="4"/></padding>
                                <Button fx:id="btnRegister" text="TẠO TÀI KHOẢN" onAction="#handleRegister"
                                        styleClass="btn-action" prefWidth="180.0" />
                            </HBox>
                        </VBox>
                    </Tab>
                </TabPane>

                <!-- Status Feedback Label -->
                <Label fx:id="lblStatus" text="Sẵn sàng đăng nhập vào hệ thống phân tán." styleClass="status-label-normal" wrapText="true"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="8" right="20" bottom="8" left="20"/>
            </padding>
            <Label text="RMIDataSync © 2026 - Kiểm soát phiên duy nhất trên mạng phân tán" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>
